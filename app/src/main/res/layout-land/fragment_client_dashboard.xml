<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ClientDashboard">

    <LinearLayout
        android:id="@+id/controlHeader"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/controlProjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room control"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                tools:text="Google Pixel 8" />
        </LinearLayout>

        <TextView
            android:id="@+id/lastSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            tools:text="Updated moments ago" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/serverStatusCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/online_back_color"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/serverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="Online"
                android:textColor="@color/online_front_color"
                android:textSize="11sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlProjectRail"
        android:layout_width="196dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controlHeader"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:text="ROOMS &amp; PROJECTS"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/controlProjectList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/controlModuleGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/controlProjectRail"
        app:layout_constraintTop_toBottomOf="@id/controlHeader" />

    <TextView
        android:id="@+id/controlEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Waiting for a project from the host"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/controlModuleGrid"
        app:layout_constraintEnd_toEndOf="@id/controlModuleGrid"
        app:layout_constraintStart_toStartOf="@id/controlModuleGrid"
        app:layout_constraintTop_toTopOf="@id/controlModuleGrid" />

    <!-- These views keep the portrait binding contract while remaining out of the control panel. -->
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView android:id="@+id/serverUrl" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/ipAddress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <include android:id="@+id/projectsStat" layout="@layout/item_client_stat_projects" />
        <include android:id="@+id/modulesStat" layout="@layout/item_client_stat_modules" />
        <include android:id="@+id/sensorsStat" layout="@layout/item_client_stat_sensors" />
        <include android:id="@+id/streamsStat" layout="@layout/item_client_stat_streams" />
        <TextView android:id="@+id/syncSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
