<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".WebUI">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:id="@+id/dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:text="OSSI Dashboard"
        android:textStyle="bold"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <WebView
        android:id="@+id/webRenderer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/dashboard"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="16dp"/>

    <ProgressBar
        android:id="@+id/webViewProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/webRenderer"
        app:layout_constraintBottom_toBottomOf="@id/webRenderer"
        app:layout_constraintStart_toStartOf="@id/webRenderer"
        app:layout_constraintEnd_toEndOf="@id/webRenderer"/>

</androidx.constraintlayout.widget.ConstraintLayout>