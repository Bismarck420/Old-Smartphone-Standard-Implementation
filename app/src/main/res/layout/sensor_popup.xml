<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/popup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/popupContainer">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="50mm"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/onBoardSensorCard"
                app:layout_constraintStart_toStartOf="parent">

                <ScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:id="@+id/scrollView">

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/onBoardSensorList">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/constraints">
                            <TextView
                                android:id="@+id/onBoardSensorsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:text="OnBoard Sensors"
                                android:textStyle="bold"
                                android:paddingEnd="16dp"
                                android:layout_margin="8dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toTopOf="@id/onBoardSensorContainer"
                                app:layout_constraintStart_toStartOf="parent"/>
                            <Button
                                android:id="@+id/cancel_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintStart_toEndOf="@id/onBoardSensorsTitle"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:text="Cancel" />


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:layout_constraintTop_toBottomOf="@id/onBoardSensorsTitle"
                                app:layout_constraintBottom_toTopOf="@id/addSensorButton"
                                android:orientation="vertical"
                                android:id="@+id/onBoardSensorContainer">

                            </LinearLayout>

                            <Button
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:text="Add Sensor"
                                android:id="@+id/addSensorButton"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </HorizontalScrollView>
                </ScrollView>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>